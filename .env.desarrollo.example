# ──────────────────────────────────────────────────────────────────────────────
# PLANTILLA del entorno de DESARROLLO (sin secretos; sí va al repositorio).
#
# Solo contiene las claves que CAMBIAN respecto a producción. El comando
#   ./scripts/cambiar-entorno.sh preparar
# copia tu .env.produccion y le aplica estos valores para generar .env.desarrollo.
#
# Después edita .env.desarrollo y pon TU usuario/contraseña de la BD de desarrollo.
# ──────────────────────────────────────────────────────────────────────────────

APP_DEBUG=true

# Base de datos espejo en el servidor local de la red
DB_HOST=192.168.10.13
DB_PORT=3308
DB_DATABASE=desarrolloappcorpen
DB_USERNAME=CAMBIAR_AQUI
DB_PASSWORD=CAMBIAR_AQUI

# Correo: todo va a Mailpit (http://localhost:8025), nunca a destinatarios reales
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Archivos: sin credenciales de AWS para no escribir/borrar en el bucket de producción
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
