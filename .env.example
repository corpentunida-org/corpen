APP_NAME=Corpen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=corpen
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Disco 's3' (config/filesystems.php) — usado por todos los módulos que suben
# archivos (Archivo, SGRH, Correspondencia, Cartera, Seguros, Reservas,
# Interacciones, Inventario, Soportes, Indicators). AWS_ENDPOINT y
# AWS_USE_PATH_STYLE_ENDPOINT se dejan sin definir salvo que el bucket sea
# S3-compatible (MinIO, Spaces, etc.) en vez de AWS S3 real.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

API_PRODUCCION=
TOKEN_ADMIN=
